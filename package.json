{
  "name": "ultra-hero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/patch-next-image-optimizer.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "messages:check": "tsx scripts/check-messages.ts",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "bash scripts/db/test-rls.sh",
    "db:local:reset": "bash scripts/db/local-reset.sh",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:postgres@127.0.0.1:5432/ultra_hero_local --schema public > src/lib/supabase/database.types.ts",
    "eval:recommendations": "tsx scripts/eval-recommendations.ts",
    "check": "npm run typecheck && npm run lint && npm run messages:check && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "15.5.28",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
