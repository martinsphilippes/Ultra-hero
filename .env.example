# ---------------------------------------------------------------- Supabase (obrigatório)
# Project Settings → API. A chave publicável é segura no navegador (RLS protege os dados).
NEXT_PUBLIC_SUPABASE_URL=https://cjcvlfypjoxaynwtmuhz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role: SOMENTE no servidor (Vercel env "Production/Preview", nunca NEXT_PUBLIC_).
# Usada por: recomendações (escrita), cron de transporte/retenção, provisionamento de contas demo.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- App
# URL pública do site (callbacks de auth, links de certificado). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo exigido pelos endpoints /api/cron/* (Vercel Cron envia Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ---------------------------------------------------------------- Google OAuth (opcional)
# Configurado no painel Supabase (Authentication → Providers → Google), não aqui.
# Callback a cadastrar no Google Cloud: https://cjcvlfypjoxaynwtmuhz.supabase.co/auth/v1/callback

# ---------------------------------------------------------------- IA (opcional)
# Sem chaves, o motor usa o fallback determinístico (identificado como tal na UI e nas métricas).
AI_PROVIDER=deterministic            # deterministic | openai | gemini (pode ser sobrescrito em app_settings)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------- Vídeo (opcional)
# POC usa embeds (YouTube/Vimeo) e player de demonstração. Ver docs/decisions/ADR-001-video-provider.md
# Para o herói enviar vídeo gravado no celular (até 3 min): VIDEO_PROVIDER=cloudflare_stream + as três
# variáveis CLOUDFLARE_* abaixo. Faltando qualquer uma, a tela de post mostra "vídeo ainda não configurado".
VIDEO_PROVIDER=embed                 # embed | cloudflare_stream | mux
# Painel Cloudflare → Stream: Account ID (lateral direita da visão geral).
CLOUDFLARE_ACCOUNT_ID=
# API token com permissão "Stream: Edit" (somente servidor; nunca NEXT_PUBLIC_).
CLOUDFLARE_STREAM_API_TOKEN=
# Código do subdomínio de entrega: customer-<CODE>.cloudflarestream.com (só o <CODE>).
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Opcionais, só para conteúdo premium com URL assinada (ainda não implementado; sem elas, premium fica indisponível).
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Preço por 1M tokens (US$) para estimar custo em recommendation_runs; vazio usa a tabela interna por modelo.
OPENAI_PRICE_IN_PER_1M=
OPENAI_PRICE_OUT_PER_1M=
GEMINI_PRICE_IN_PER_1M=
GEMINI_PRICE_OUT_PER_1M=
